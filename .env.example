# ===================================================
# TRUSTLENS CONFIGURATION (.env.example)
# Copy this file to .env in server/ or root
# Never commit real secrets to source control.
# ===================================================

# Server Environment
NODE_ENV=development
PORT=8787
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=fgfghghg

# Authentication Secrets (Generate strong, independent secrets in production)
# e.g., openssl rand -base64 48
JWT_ACCESS_SECRET=trustlens_dev_access_secret_do_not_use_in_prod_key_382910398
JWT_REFRESH_SECRET=trustlens_dev_refresh_secret_do_not_use_in_prod_key_771928301
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# AI Provider Configuration (OpenAI or any OpenAI-compatible provider: Groq, DeepSeek, Together, Ollama, etc.)
# If left empty, TrustLens seamlessly activates its high-precision rule-based Pattern Intelligence fallback!
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Email Provider Configuration (Resend, SendGrid, SMTP, etc.)
# If left empty, emails (verification, reset tokens) will log securely to backend console in development.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@trustlens.app
